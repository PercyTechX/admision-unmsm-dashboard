{
  "name": "Admisión UNMSM (guinda)",
  "dataColors": ["#9E0C26", "#B9AEAC", "#6B0719", "#D98C99", "#5A5254", "#E8B4BE", "#756C6E", "#F6E1E5"],
  "foreground": "#1F1A1B",
  "foregroundNeutralSecondary": "#5A5254",
  "foregroundNeutralTertiary": "#756C6E",
  "background": "#FFFFFF",
  "backgroundLight": "#FAF5F4",
  "backgroundNeutral": "#ECE6E4",
  "tableAccent": "#9E0C26",
  "good": "#9E0C26",
  "neutral": "#B9AEAC",
  "bad": "#6B0719",
  "minimum": "#F6E1E5",
  "center": "#D98C99",
  "maximum": "#9E0C26",
  "textClasses": {
    "callout": { "fontSize": 28, "fontFace": "Segoe UI Bold", "color": "#1F1A1B" },
    "title": { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#1F1A1B" },
    "header": { "fontSize": 11, "fontFace": "Segoe UI Semibold", "color": "#1F1A1B" },
    "label": { "fontSize": 10, "fontFace": "Segoe UI", "color": "#5A5254" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#ECE6E4" } }, "radius": 12 }],
        "dropShadow": [{
          "show": true,
          "color": { "solid": { "color": "#3C141C" } },
          "position": "Outer",
          "preset": "Custom",
          "shadowSpread": 0,
          "shadowBlur": 12,
          "angle": 90,
          "shadowDistance": 3,
          "transparency": 88
        }],
        "padding": [{ "top": 12, "bottom": 12, "left": 14, "right": 14 }],
        "title": [{ "show": true, "fontColor": { "solid": { "color": "#1F1A1B" } }, "fontSize": 13, "fontFamily": "Segoe UI Semibold" }],
        "subTitle": [{ "show": true, "fontColor": { "solid": { "color": "#756C6E" } }, "fontSize": 10, "fontFamily": "Segoe UI" }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F5F1EF" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#F5F1EF" } }, "transparency": 0 }]
      }
    },
    "textbox": {
      "*": {
        "border": [{ "show": false }],
        "dropShadow": [{ "show": false }]
      }
    }
  }
}
